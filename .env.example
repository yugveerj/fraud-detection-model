# Copy to .env (gitignored) and fill in. Nothing secret is committed.

# --- Kaggle (Phase A data pull) ---
# Preferred: place kaggle.json at ~/.kaggle/kaggle.json (chmod 600).
# Alternatively, set these and the fetch pipeline will write a temp config.
KAGGLE_USERNAME=
KAGGLE_KEY=

# --- AWS (Phase D deploy; owner/CI only) ---
AWS_REGION=us-west-2
AWS_PROFILE=

# --- MLflow (Phase B) ---
MLFLOW_TRACKING_URI=file:./mlruns

# --- Project paths ---
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
