# --- Raw competition data: NEVER commit (CLAUDE.md hard rule) ---
data/*
!data/.gitkeep
*.csv
*.csv.zip
*.parquet
!tests/fixtures/*.parquet
!tests/fixtures/*.csv

# --- Secrets ---
.env
.env.*
!.env.example
kaggle.json
**/kaggle.json
.aws/
*.pem

# --- Model / experiment artifacts (derived binaries are committed selectively) ---
mlruns/
mlartifacts/
mlflow.db
mlflow.db-*
# Model binaries are regenerated by `pipeline.train`; we commit the metadata +
# report, not the (synthetic, version-sensitive) binary itself.
*.joblib
*.pkl
# Serving bundle + presets are rebuilt by `serving.artifact` at image-build time.
# The demo's data snapshot lives at web/presets.json (committed).
artifacts/serving/

# Monitoring site output is published to gh-pages by the cron, not committed here.
site/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
.uv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- Terraform ---
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- R ---
.Rhistory
.RData
.Rproj.user/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
